# Optional. The application runs without these in deterministic mode.
# Put real values in .env.local (gitignored), not in this template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional: OpenAI-compatible endpoint for another provider (e.g. GLM/Zhipu).
# Required when OPENAI_MODEL is not an OpenAI-hosted model (for example glm-*).
# The OpenAI SDK reads this automatically; the app loads it from .env.local.
# OPENAI_BASE_URL=https://your-provider.example.com/v1
AI_MUSIC_APP_MODE=deterministic
AI_MUSIC_PROMPT_VERSION=2026-08-01.v1
# PostgreSQL connection. The default below matches `docker compose up -d`.
# For a hosted deployment (Neon/Supabase/Vercel Postgres), put the real URL in
# .env.local (gitignored) instead of here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mt_simulator
